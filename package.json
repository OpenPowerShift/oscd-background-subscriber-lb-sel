{
  "name": "@openpowershift/oscd-menu-subscriber-lb-sel",
  "description": "Companion plugin for the OpenSCD Subscriber Later Binding plugin which maps further inputs of SEL devices",
  "license": "Apache-2.0",
  "author": "OpenPowerShift",
  "contributors": [
    "Daniel Mulholland"
  ],
  "version": "0.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenPowerShift/oscd-menu-subscriber-lb-sel.git"
  },
  "bugs": {
    "url": "https://github.com/OpenPowerShift/oscd-menu-subscriber-lb-sel/issues"
  },
  "keywords": [
    "OpenSCD",
    "IEC 61850",
    "SCL",
    "GOOSE",
    "SMV",
    "later binding",
    "SEL"
  ],
  "main": "dist/oscd-menu-subscriber-lb-sel.js",
  "module": "dist/oscd-menu-subscriber-lb-sel.js",
  "exports": {
    ".": "./dist/oscd-menu-subscriber-lb-sel.js"
  },
  "files": [
    "dist",
    "!dist/**/*.spec.*",
    "!dist/**/*.test.*",
    "!dist/testing",
    "!dist/demo"
  ],
  "scripts": {
    "clean": "node -e \"require(\\\"fs\\\").rmSync(\\\"dist\\\",{recursive:true,force:true})\"",
    "extract": "lit-localize extract",
    "localize": "lit-localize build",
    "lint": "oscd lint",
    "format": "oscd lint --format",
    "start": "npm run extract && npm run localize && oscd start",
    "start:bundle": "oscd start-bundle",
    "build": "npm run clean && npm run extract && npm run localize && oscd build --no-clean",
    "bundle": "npm run clean && npm run extract && npm run localize && oscd bundle --no-clean",
    "test": "oscd test",
    "test:watch": "oscd test --watch",
    "test:visual": "oscd test --visual",
    "updates": "oscd updates",
    "deploy": "oscd deploy",
    "prepare": "oscd install-hooks",
    "pretest": "npm run clean && npm run extract && npm run localize",
    "pretest:visual": "npm run clean && npm run extract && npm run localize"
  },
  "dependencies": {
    "@lit/localize": "^0.12.2",
    "@omicronenergy/oscd-ui": "^0.1.1",
    "@open-wc/scoped-elements": "^3.0.10",
    "@openscd/oscd-api": "^0.1.6",
    "@openscd/scl-lib": "^2.0.1",
    "lit": "^3.3.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@fontsource/material-symbols-outlined": "^5.3.9",
    "@fontsource/roboto": "^5.3.0",
    "@lit/localize-tools": "^0.8.2",
    "@omicronenergy/oscd-menu-open": "^0.0.6",
    "@omicronenergy/oscd-menu-save": "^0.0.2",
    "@omicronenergy/oscd-shell": "^0.0.18",
    "@omicronenergy/oscd-tooling": "0.0.8",
    "@open-wc/testing": "^4.0.0",
    "@openscd/oscd-editor": "^1.8.0",
    "@types/node": "^20.19.43",
    "@web/test-runner-commands": "^0.9.0",
    "@web/test-runner-playwright": "0.11.1",
    "@web/test-runner-visual-regression": "^0.10.0",
    "@webcomponents/scoped-custom-element-registry": "^0.0.10",
    "sinon": "^22.1.0"
  }
}
